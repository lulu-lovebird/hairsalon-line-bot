# ============================================================
# 系統超級管理員設定 (Super Admin)
# ============================================================
# 填入店長的 LINE User ID，多個可用逗號隔開
ADMIN_LINE_IDS=U_your_line_user_id

# ============================================================
# 店家資訊
# ============================================================
SALON_NAME=您的理髮店名稱
SALON_ADDRESS=店家地址
SALON_PHONE=02-XXXX-XXXX

# ============================================================
# LINE 開發者後台設定 (LINE Developers Console)
# ============================================================
LINE_CHANNEL_ID=your_line_channel_id
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token

# ============================================================
# LIFF 設定
# ============================================================
# Admin LIFF App (後台管理用)
LIFF_ADMIN_ID=your_admin_liff_id
NEXT_PUBLIC_LIFF_ADMIN_ID=your_admin_liff_id

# ============================================================
# Supabase 資料庫設定
# ============================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ============================================================
# 應用程式設定
# ============================================================
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ============================================================
# 預約通知排程 (Cron Secret)
# 用於保護 /api/notify/cron 端點，由 Vercel Cron 呼叫時帶入
# ============================================================
CRON_SECRET=your_random_secret_string

# ============================================================
# 除錯模式
# ============================================================
DEBUG=off
